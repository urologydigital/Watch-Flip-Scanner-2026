# eBay developer credentials (production keyset) - required
EBAY_CLIENT_ID=your-ebay-app-id
EBAY_CLIENT_SECRET=your-ebay-cert-id

# Optional: AI analysis (Phase 3). Only one is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cost control
MAX_AI_CANDIDATES_PER_SCAN=10

# Tuning
WFS_RESULTS_PER_QUERY=50
WFS_PREFILTER_PRICE_RATIO=0.80
WFS_ILLIQUID_EXTRA_DISCOUNT=0.07

# Phase 2: resale economics
# LEGACY (Phase 2 classic scan only). NOT the Phase 5+ seller economics —
# those live in settings.json / the Settings tab, or the WFS51_* vars below.
WFS_SELLING_FEE_PCT=0.13
WFS_FIXED_SELLING_COSTS=25
WFS_REQUIRED_PROFIT_MARGIN=0.12
WFS_MAX_RISK_BUFFER=0.30
WFS_SOLD_PERIOD_DAYS=90

# Phase 3: asking-market cross-check and AI
# Chrono24 automated lookup is OFF by default. Enabling it is your decision:
# automated collection may breach Chrono24's terms of use.
WFS_CHRONO24_ENABLED=0
WFS_CHRONO24_MIN_INTERVAL=6
WFS_AI_ENABLED=1

# ---------------------------------------------------------------------------
# Phase 5: flip intelligence
# ---------------------------------------------------------------------------
# Selling and transaction costs
# NOTE: superseded in Phase 5.1. These variables are no longer read.
# Seller economics now live in settings.json (Settings tab) or the WFS51_* vars below.

# MAX BUY stances
WFS5_CONSERVATIVE_MARGIN=0.18
WFS5_CONSERVATIVE_BUFFER=0.06
WFS5_STANDARD_MARGIN=0.12
WFS5_STANDARD_BUFFER=0.03
WFS5_AGGRESSIVE_MARGIN=0.08
WFS5_AGGRESSIVE_BUFFER=0.0
WFS5_AGGRESSIVE_MIN_CONFIDENCE=80
WFS5_AGGRESSIVE_MIN_LIQUIDITY=70

# Decision thresholds
WFS5_MIN_NET_PROFIT=150
WFS5_MIN_NET_ROI=10
WFS5_MIN_CONFIDENCE=60
WFS5_MIN_LIQUIDITY=40
WFS5_MAX_HOLDING_DAYS=90
WFS5_MAX_RISK_SCORE=45
WFS5_BUY_MIN_FLIP=65
WFS5_WATCH_MIN_FLIP=40
WFS5_WATCH_MAX_OVERPRICE_PCT=25

# Flip Score weights (must sum to 1.0)
WFS5_W_PROFIT=0.25
WFS5_W_LIQUIDITY=0.20
WFS5_W_VELOCITY=0.15
WFS5_W_CONFIDENCE=0.15
WFS5_W_DISCOUNT=0.10
WFS5_W_CONDITION=0.10
WFS5_W_RISK=0.05

# Capital velocity
WFS5_EXCELLENT_PROFIT_PER_30D=400
WFS5_SLOW_HOLDING_DAYS=120

# Caching / API efficiency
WFS5_CACHE_ENABLED=1
WFS5_MARKET_TTL_HOURS=24
WFS5_LISTING_TTL_MINUTES=45

# ---------------------------------------------------------------------------
# Phase 5.1: seller economics
# Preferred route is the Settings tab, which persists to settings.json.
# These environment variables set the DEFAULTS a profile starts from.
# ---------------------------------------------------------------------------

# UK private seller (default). eBay charges private sellers no selling fee.
WFS51_PRIVATE_TRANSACTION_FEE_PCT=0.0
WFS51_PRIVATE_PAYMENT_FEE_PCT=0.0
WFS51_PRIVATE_FIXED_FEE_GBP=0.0

# UK business seller — ESTIMATES. Replace from a real eBay invoice.
WFS51_BUSINESS_TRANSACTION_FEE_PCT=0.093
WFS51_BUSINESS_PAYMENT_FEE_PCT=0.0
WFS51_BUSINESS_REGULATORY_FEE_PCT=0.0035
WFS51_BUSINESS_FIXED_FEE_GBP=0.30

# Optional charges, off by default
WFS51_PROMOTED_ENABLED=0
WFS51_PROMOTED_FEE_PCT=0.0
WFS51_INTERNATIONAL_SALE=0
WFS51_INTERNATIONAL_FEE_PCT=0.0

# Seller-side physical costs (apply to every profile)
WFS51_SHIPPING_GBP=12
WFS51_INSURANCE_GBP=15
WFS51_PACKAGING_GBP=5
WFS51_AUTHENTICATION_GBP=0
WFS51_MISC_GBP=0

# Reserves and allowances
WFS51_SERVICE_RESERVE_PCT=0.02
WFS51_NEGOTIATION_PCT=0.0

# ---------------------------------------------------------------------------
# Phase 5.3: automatic evidence collection
# Preferred route is Settings -> Automatic Market Evidence (persisted).
# ---------------------------------------------------------------------------
WFS53_EVIDENCE_SHORTLIST_CAP=15
WFS53_EVIDENCE_LOOKBACK_DAYS=365

# Optional public-web collectors. OFF by default; each site's terms still apply.
WFS53_EBAY_SOLD_WEB=0
WFS53_WATCHCHARTS_ENABLED=0

# Optional Playwright adapter: pip install playwright && playwright install chromium
WFS53_BROWSER_ENABLED=0

# FX rates: units of currency per 1 GBP. No live feed; unknown currencies skipped.
WFS53_FX_EUR=1.17
WFS53_FX_USD=1.27
WFS53_FX_CHF=1.12
